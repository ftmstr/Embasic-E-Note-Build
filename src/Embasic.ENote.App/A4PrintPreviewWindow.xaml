<Window x:Class="Embasic.ENote.App.A4PrintPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        x:ClassModifier="internal" Title="A4 Baskı Önizlemesi" Width="880" Height="760" MinWidth="420" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Background="#F1F5F9">
        <DockPanel DockPanel.Dock="Top" Margin="12">
            <Button DockPanel.Dock="Right" Content="Kapat" IsCancel="True" Padding="10,5"
                    AutomationProperties.AutomationId="ClosePrintPreview"/>
            <Button DockPanel.Dock="Right" x:Name="PrintButton" Content="Yazdır…"
                    Click="Print_Click" Padding="10,5" Margin="6,0"/>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="PreviousPageButton" Content="Önceki" Click="PreviousPage_Click" Padding="10,5"/>
                <Button x:Name="NextPageButton" Content="Sonraki" Click="NextPage_Click" Padding="10,5" Margin="6,0"/>
                <TextBlock x:Name="PageCounter" VerticalAlignment="Center" Margin="4,0"/>
            </StackPanel>
        </DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="12,4,12,12">
            <TextBlock x:Name="PrintGeometry" TextWrapping="Wrap"/>
            <TextBlock x:Name="PrintStatus" TextWrapping="Wrap" Margin="0,4,0,0"
                       AutomationProperties.LiveSetting="Polite"/>
        </StackPanel>
        <Viewbox Margin="12,0,12,4" Stretch="Uniform" StretchDirection="DownOnly">
            <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" ClipToBounds="True">
                <primitives:DocumentPageView x:Name="PreviewPage" Stretch="None"
                                             AutomationProperties.Name="A4 içerik sayfası"/>
            </Border>
        </Viewbox>
    </DockPanel>
</Window>
