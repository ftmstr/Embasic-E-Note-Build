<Window x:Class="Embasic.ENote.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Embasic.ENote.App.ViewModels"
        Title="Embasic E-Note"
        Icon="/Embasic.ENote.App;component/Assets/Embasic-E-Note.ico"
        Width="1200" Height="780" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowSurface}" FontFamily="Segoe UI"
        PreviewKeyDown="Window_PreviewKeyDown" Closing="Window_Closing">
    <Window.Resources>
        <SolidColorBrush x:Key="WindowSurface" Color="#F7F9FC"/>
        <SolidColorBrush x:Key="PanelSurface" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="PrimaryInk" Color="#172033"/>
        <SolidColorBrush x:Key="SecondaryInk" Color="#64748B"/>
        <HierarchicalDataTemplate DataType="{x:Type vm:WorkspaceTreeNode}"
                                  ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal" ToolTip="{Binding FullPath}">
                <TextBlock Text="{Binding Symbol}" Margin="0,0,8,0"
                           FontFamily="Segoe UI Emoji"/>
                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource PrimaryInk}"
                           AutomationProperties.Name="{Binding Name}"/>
            </StackPanel>
        </HierarchicalDataTemplate>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="58"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="29"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{DynamicResource PanelSurface}" BorderBrush="#E2E8F0"
                BorderThickness="0,0,0,1">
            <DockPanel Margin="20,0" VerticalAlignment="Center">
                <Button x:Name="ThemeToggleButton" Content="Koyu tema" DockPanel.Dock="Right"
                        Click="ToggleTheme_Click" Padding="10,5"
                        AutomationProperties.Name="Açık veya koyu tema değiştir"/>
                <Image x:Name="BrandLogo" Width="44" Height="44" Stretch="Uniform"
                       Source="/Embasic.ENote.App;component/Assets/Logo-Light.png"
                       Margin="0,0,12,0"
                       AutomationProperties.Name="Embasic gerçek marka logosu"/>
                <TextBlock Text="E-Note" FontWeight="SemiBold" FontSize="17"
                           Foreground="{DynamicResource PrimaryInk}"/>
                <TextBlock Text="  ·  Çevrimdışı not defteri"
                           FontSize="12" Foreground="{DynamicResource SecondaryInk}" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="220"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*" MinWidth="400"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0" Background="{DynamicResource PanelSurface}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Margin="14,16,14,8">
                    <TextBlock Text="ÇALIŞMA ALANI" FontSize="12" FontWeight="Bold"
                               Foreground="#475569"/>
                    <Button Content="Klasör Seç…" Height="33" Margin="0,10,0,6"
                            AutomationProperties.AutomationId="ChooseWorkspaceButton"
                            Command="{Binding ChooseWorkspaceCommand}"/>
                    <Button Content="Notlarda Ara… (Ctrl+Shift+F)" Margin="0,0,0,6" Padding="8,5"
                            Click="ShowWorkspaceSearch_Click" AutomationProperties.AutomationId="ShowWorkspaceSearchButton"/>
                    <TextBlock Text="{Binding WorkspaceLabel}"
                               TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource SecondaryInk}"
                               AutomationProperties.Name="Seçili çalışma alanı"/>
                    <WrapPanel Margin="0,10,0,0">
                        <Button Content="Yeni Alt Klasör" Padding="8,5"
                                Margin="0,0,8,0" Command="{Binding CreateFolderCommand}"/>
                        <Button x:Name="CreateWorkspaceMarkdownButton" Content="Yeni .md…"
                                Click="CreateWorkspaceMarkdown_Click" IsEnabled="False"
                                AutomationProperties.AutomationId="CreateWorkspaceMarkdownButton"
                                Padding="8,5" Margin="0,0,8,0"/>
                        <Button Content="Yenile" Padding="8,5"
                                Command="{Binding RefreshCommand}"/>
                    </WrapPanel>
                    <WrapPanel Margin="0,8,0,0">
                        <Button x:Name="RenameEntryButton" Content="Adlandır…" Click="RenameEntry_Click"
                                AutomationProperties.AutomationId="RenameEntryButton" IsEnabled="False" Padding="6,4" Margin="0,0,5,5"/>
                        <Button x:Name="MoveEntryButton" Content="Taşı…" Click="MoveEntry_Click"
                                AutomationProperties.AutomationId="MoveEntryButton" IsEnabled="False" Padding="6,4" Margin="0,0,5,5"/>
                        <Button x:Name="TrashEntryButton" Content="Silinenlere taşı" Click="TrashEntry_Click"
                                AutomationProperties.AutomationId="TrashEntryButton" IsEnabled="False" Padding="6,4" Margin="0,0,5,5"/>
                        <Button x:Name="UndoTrashButton" Content="Silmeyi geri al" Click="UndoTrash_Click"
                                AutomationProperties.AutomationId="UndoTrashButton" IsEnabled="False" Padding="6,4"/>
                    </WrapPanel>
                    <Button Content="Yeni Güvenli Not (.emd) — Yakında"
                            IsEnabled="False" Margin="0,10,0,0" Height="28"
                            AutomationProperties.AutomationId="NewSecureNote"
                            AutomationProperties.HelpText="Şifreleme ve anahtar güvenliği tamamlanmadı."/>
                </StackPanel>
                <TreeView x:Name="WorkspaceTree" Grid.Row="1" Margin="10,0,10,4"
                          ItemsSource="{Binding Roots}" BorderThickness="0"
                          SelectedItemChanged="WorkspaceTree_SelectedItemChanged"
                          TreeViewItem.Expanded="WorkspaceTree_Expanded"
                          MouseDoubleClick="WorkspaceTree_MouseDoubleClick"
                          VirtualizingStackPanel.IsVirtualizing="True"
                          VirtualizingStackPanel.VirtualizationMode="Recycling"
                          ScrollViewer.CanContentScroll="True"
                          AutomationProperties.Name="Klasör ve not ağacı" AutomationProperties.AutomationId="WorkspaceTree"/>
                <Border Grid.Row="2" Margin="14" Padding="10"
                        BorderBrush="#E2E8F0" BorderThickness="1"
                        CornerRadius="5" MinHeight="76"
                        AutomationProperties.Name="Etkin olmayan reklam alanı">
                    <StackPanel>
                        <TextBlock Text="REKLAM" FontSize="10"
                                   Foreground="{DynamicResource SecondaryInk}" FontWeight="Bold"/>
                        <TextBlock Text="Sağlayıcı yok · çevrimdışı / pasif"
                                   TextWrapping="Wrap" Margin="0,6,0,0"
                                   Foreground="{DynamicResource SecondaryInk}"/>
                    </StackPanel>
                </Border>
            </Grid>
            <GridSplitter Grid.Column="1" ResizeDirection="Columns"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Background="#E2E8F0" ShowsPreview="True"/>
            <Grid Grid.Column="2" Margin="18">
                <TabControl x:Name="MainSections" SelectedIndex="1">
                    <TabItem Header="Çalışma Alanı">
                        <StackPanel Margin="26">
                            <TextBlock Text="Embasic E-Note" FontSize="27"
                                       FontWeight="SemiBold" Foreground="{DynamicResource PrimaryInk}"/>
                            <TextBlock Margin="0,18,0,0" TextWrapping="Wrap"
                                       Foreground="#334155"
                                       Text="Klasör seçimi, alt klasörler ve belge ağacı mevcut. .md metni ve basit .rtf belgeleri yerel olarak düzenleyebilirsiniz. DOCX/ODT tam görsel sadakati henüz yok."/>
                            <TextBlock Margin="0,15,0,0" TextWrapping="Wrap"
                                       Foreground="#475569"
                                       Text="{Binding SelectionDescription}"/>
                            <TextBlock Margin="0,16,0,0" TextWrapping="Wrap"
                                       Foreground="#9A3412"
                                       Text="Güvenlik: .emd şifreleme ve anahtar yönetimi uygulanana kadar .emd oluşturma, açma ve kaydetme devre dışı."/>
                        </StackPanel>
                    </TabItem>
                    <TabItem x:Name="MarkdownSectionTab" Header="Notlar (.md)" AutomationProperties.AutomationId="MarkdownNotesTab">
                        <DockPanel Margin="10">
                            <StackPanel DockPanel.Dock="Top">
                                <WrapPanel Margin="0,0,0,8">
                                    <Button Content="Yeni .md (Ctrl+Alt+N)" Click="NewMarkdown_Click" Padding="8,5" Margin="0,0,6,0"/>
                                    <Button Content="Aç (Ctrl+O)" Click="OpenMarkdown_Click" Padding="8,5" Margin="0,0,6,0"
                                            AutomationProperties.AutomationId="OpenMarkdownButton"/>
                                    <Button Content="RTF Düzenle (Ctrl+Alt+R)" Click="OpenRtf_Click" Padding="8,5" Margin="0,0,6,0"/>
                                    <Button Content="DOCX / ODT (Ctrl+Alt+D)" Click="OpenOfflineWord_Click" Padding="8,5" Margin="0,0,6,0"/>
                                    <Button Content="Kaydet (Ctrl+S)" Click="SaveMarkdown_Click" Padding="8,5" Margin="0,0,6,0"/>
                                    <Button x:Name="ExportDocumentCopyButton" Content="Dışa Aktar…" Click="ExportCopy_Click" IsEnabled="False" Padding="8,5" Margin="0,0,6,0" AutomationProperties.AutomationId="ExportDocumentCopyButton"/>
                                    <Button Content="Bul / Değiştir (Ctrl+F)" Click="ShowFind_Click" Padding="8,5" Margin="0,0,6,0" AutomationProperties.AutomationId="ShowFindButton"/>
                                    <Button x:Name="ExportMarkdownUdfButton" Content="UDF Kopyası" Click="ExportMarkdownUdf_Click"
                                            IsEnabled="False" Padding="8,5" Margin="0,0,6,0"/>
                                    <Button x:Name="PrintPreviewButton" Content="Baskı Önizlemesi (Ctrl+P)"
                                            Click="PrintPreview_Click" IsEnabled="False" Padding="8,5" Margin="0,0,6,0"/>
                                    <Button Content="Sekmeyi Kapat" Click="CloseMarkdown_Click" Padding="8,5"/>
                                    <TextBlock Text="Görünüm:" VerticalAlignment="Center" Margin="16,0,5,0"/>
                                    <ComboBox x:Name="MarkdownModeSelector" Width="130" Height="30"
                                              SelectedIndex="2" SelectionChanged="MarkdownMode_Changed"
                                              AutomationProperties.Name="Markdown görünüm modu">
                                        <ComboBoxItem Content="Yaz"/>
                                        <ComboBoxItem Content="Önizle"/>
                                        <ComboBoxItem Content="Bölünmüş"/>
                                    </ComboBox>
                                </WrapPanel>
                                <WrapPanel Margin="0,0,0,8">
                                    <Button Content="Kalın" Tag="bold" Click="FormatMarkdown_Click" Padding="8,4"/>
                                    <Button Content="İtalik" Tag="italic" Click="FormatMarkdown_Click" Padding="8,4"/>
                                    <Button Content="Başlık" Tag="heading" Click="FormatMarkdown_Click" Padding="8,4"/>
                                    <Button Content="Liste" Tag="list" Click="FormatMarkdown_Click" Padding="8,4"/>
                                    <Button Content="Alıntı" Tag="quote" Click="FormatMarkdown_Click" Padding="8,4"/>
                                    <Button Content="Kod" Tag="code" Click="FormatMarkdown_Click" Padding="8,4"/>
                                    <Button Content="Tablo" Tag="table" Click="FormatMarkdown_Click" Padding="8,4"/>
                                </WrapPanel>
                                <StackPanel x:Name="FindBar" Visibility="Collapsed" Margin="0,0,0,8">
                                    <WrapPanel>
                                        <TextBlock Text="Bul:" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryInk}" Margin="0,0,5,0"/>
                                        <TextBox x:Name="SearchTermBox" Width="180" TextChanged="FindQuery_Changed" KeyDown="FindTerm_KeyDown" AutomationProperties.AutomationId="SearchTermBox"/>
                                        <Button Content="Önceki" Click="FindPrevious_Click"/>
                                        <Button Content="Sonraki" Click="FindNext_Click" AutomationProperties.AutomationId="FindNextButton"/>
                                        <CheckBox x:Name="FindCaseSensitive" Content="Harf duyarlı" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryInk}" Margin="8,0"/>
                                        <Button Content="Kapat" Click="HideFind_Click"/>
                                    </WrapPanel>
                                    <WrapPanel Margin="0,5,0,0">
                                        <TextBlock Text="Yeni:" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryInk}" Margin="0,0,5,0"/>
                                        <TextBox x:Name="ReplaceTermBox" Width="180" AutomationProperties.AutomationId="ReplaceTermBox"/>
                                        <Button Content="Değiştir" Click="ReplaceOne_Click"/>
                                        <Button Content="Tümünü Değiştir" Click="ReplaceAll_Click" AutomationProperties.AutomationId="ReplaceAllButton"/>
                                    </WrapPanel>
                                    <TextBlock x:Name="FindStatusText" Foreground="{DynamicResource SecondaryInk}"/>
                                </StackPanel>
                                <TextBlock Text="Markdown kaynak + güvenli salt okunur görsel önizleme · Uzak içerik yüklenmez · Şifreli .emd kapalı"
                                           Foreground="{DynamicResource SecondaryInk}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <Border x:Name="RevisionNotice" Visibility="Collapsed" BorderBrush="#B7791F"
                                        BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock x:Name="RevisionMessage" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource PrimaryInk}"
                                                   AutomationProperties.AutomationId="RevisionMessage"
                                                   AutomationProperties.LiveSetting="Polite"/>
                                        <WrapPanel Margin="0,5,0,0">
                                            <Button x:Name="ReloadRevisionButton" Content="Diskten yeniden yükle…"
                                                    Click="ReloadRevision_Click" Padding="7,4" Margin="0,0,6,0"
                                                    AutomationProperties.AutomationId="ReloadRevisionButton"/>
                                            <Button Content="Taslağı ayrı kaydet…" Click="SaveRevisionCopy_Click" Padding="7,4"
                                                    AutomationProperties.AutomationId="SaveRevisionCopyButton"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                                <TextBlock x:Name="MarkdownStatusText" AutomationProperties.AutomationId="MarkdownStatusText"
                                           Text="Not açın veya yeni .md oluşturun. PDF ve yazdırma: Baskı Önizlemesi."
                                           Foreground="{DynamicResource SecondaryInk}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                            </StackPanel>
                            <TabControl x:Name="MarkdownTabs" SelectionChanged="MarkdownTabs_SelectionChanged"
                                        AutomationProperties.Name="Açık Markdown belgeleri">
                                <TabControl.ItemContainerStyle>
                                    <Style TargetType="TabItem">
                                        <Setter Property="AutomationProperties.Name" Value="{Binding DisplayTitle}"/>
                                        <Setter Property="ToolTip" Value="{Binding FilePath}"/>
                                    </Style>
                                </TabControl.ItemContainerStyle>
                                <TabControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayTitle}" />
                                    </DataTemplate>
                                </TabControl.ItemTemplate>
                                <TabControl.ContentTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="{Binding SourceColumnWidth}"/>
                                                <ColumnDefinition Width="{Binding PreviewColumnWidth}"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Visibility="{Binding SourceVisibility}"
                                                    Background="White" BorderBrush="#CBD5E1" BorderThickness="1"
                                                    Margin="5" Padding="12">
                                                <TextBox Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap"
                                                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                                         FontFamily="Consolas" FontSize="14" BorderThickness="0"
                                                         Background="White" Foreground="#1E293B"
                                                         SpellCheck.IsEnabled="False" IsUndoEnabled="True" UndoLimit="200"
                                                         IsReadOnly="{Binding IsInTrash}"
                                                         AutomationProperties.Name="Düzenlenebilir Markdown kaynak metni"
                                                         AutomationProperties.AutomationId="MarkdownSourceText"/>
                                            </Border>
                                            <Border Grid.Column="1" Visibility="{Binding PreviewVisibility}"
                                                    Background="White" BorderBrush="#CBD5E1" BorderThickness="1"
                                                    Margin="5" Padding="2">
                                                <FlowDocumentScrollViewer Document="{Binding PreviewDocument}"
                                                    IsToolBarVisible="False" IsSelectionEnabled="True"
                                                    VerticalScrollBarVisibility="Auto"
                                                    AutomationProperties.Name="Güvenli salt okunur Markdown önizlemesi"/>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </TabControl.ContentTemplate>
                            </TabControl>
                        </DockPanel>
                    </TabItem>
                    <TabItem Header="Sayfa Düzeni (önizleme)">
                        <Grid Margin="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="260"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <Image Source="/Embasic.ENote.App;component/Assets/Embasic-E-Note-Icon-512.png"
                                           Width="36" Height="36" Stretch="Uniform" Margin="0,0,9,0"
                                           AutomationProperties.Name="Embasic E-Note yeni uygulama simgesi"/>
                                    <TextBlock VerticalAlignment="Center" Text="Sayfa Düzeni" FontWeight="Bold"
                                               FontSize="19" Foreground="{DynamicResource PrimaryInk}"/>
                                </StackPanel>
                                <TextBlock Text="Kâğıt boyutu" Foreground="{DynamicResource PrimaryInk}"/>
                                <ComboBox x:Name="PageSizeComboBox" Height="32" DisplayMemberPath="Name"
                                          Margin="0,6,0,12" SelectionChanged="PageLayout_Changed"
                                          AutomationProperties.Name="Kâğıt boyutu seç"/>
                                <TextBlock Text="Sayfa yönü" Foreground="{DynamicResource PrimaryInk}"/>
                                <ComboBox x:Name="PageOrientationComboBox" Height="32" Margin="0,6,0,12"
                                          SelectedIndex="0" SelectionChanged="PageLayout_Changed"
                                          AutomationProperties.Name="Sayfa yönünü seç">
                                    <ComboBoxItem Content="Dikey"/>
                                    <ComboBoxItem Content="Yatay"/>
                                </ComboBox>
                                <TextBlock Text="Yakınlaştırma" Foreground="{DynamicResource PrimaryInk}"/>
                                <ComboBox x:Name="PageZoomComboBox" Height="32" Margin="0,6,0,12"
                                          SelectedIndex="2" SelectionChanged="PageLayout_Changed"
                                          AutomationProperties.Name="Sayfa yakınlaştırması">
                                    <ComboBoxItem Content="%50" Tag="50"/>
                                    <ComboBoxItem Content="%75" Tag="75"/>
                                    <ComboBoxItem Content="%100" Tag="100"/>
                                    <ComboBoxItem Content="%125" Tag="125"/>
                                    <ComboBoxItem Content="%150" Tag="150"/>
                                </ComboBox>
                                <TextBlock Text="Kenar boşlukları: 20 mm (örnek)"
                                           Foreground="{DynamicResource SecondaryInk}" TextWrapping="Wrap"/>
                                <TextBlock Text="Notlar sekmesinden A4 baskı önizlemesini ve Windows yazdırma penceresini açabilirsiniz."
                                           Foreground="{DynamicResource SecondaryInk}" TextWrapping="Wrap"
                                           Margin="0,12,4,0"/>
                                <TextBlock Text="Bu ekran yalnız geometri önizlemesidir; notu kaydetmez veya yazdırmaz."
                                           Foreground="#9A3412" TextWrapping="Wrap" Margin="0,12,4,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Center"
                                        VerticalAlignment="Center" Margin="22,0,12,0">
                                <Border x:Name="PagePreviewBorder" Width="148" Height="210"
                                        Background="White" BorderBrush="#94A3B8" BorderThickness="1">
                                    <TextBlock Text="A4&#10;Sayfa önizlemesi" FontSize="14" Foreground="#475569"
                                               TextAlignment="Center" TextWrapping="Wrap"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock x:Name="PageLayoutSummary" Text="A4 · 210 × 297 mm · Dikey"
                                           Foreground="{DynamicResource PrimaryInk}"
                                           TextAlignment="Center" Margin="0,12,0,0"
                                           AutomationProperties.Name="Seçilen sayfa ölçüleri"/>
                            </StackPanel>
                        </Grid>
                    </TabItem>
                    <TabItem x:Name="WorkspaceSearchTab" Header="Notlarda Ara"
                             AutomationProperties.AutomationId="WorkspaceSearchTab">
                        <DockPanel Margin="18">
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                <TextBlock Text="Çalışma alanında ara" FontSize="21" FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryInk}"/>
                                <TextBlock Text="Alt klasörler dahil, diskteki .md notlarının adı ve içeriği."
                                           TextWrapping="Wrap" Margin="0,6" Foreground="{DynamicResource SecondaryInk}"/>
                                <DockPanel Margin="0,4,0,8">
                                    <Button x:Name="CancelWorkspaceSearchButton" DockPanel.Dock="Right" Content="İptal"
                                            IsEnabled="False" Padding="10,5" Margin="6,0,0,0" Click="CancelWorkspaceSearch_Click"
                                            AutomationProperties.AutomationId="CancelWorkspaceSearchButton"/>
                                    <Button x:Name="StartWorkspaceSearchButton" DockPanel.Dock="Right" Content="Ara"
                                            Padding="12,5" Margin="6,0,0,0" Click="StartWorkspaceSearch_Click"
                                            AutomationProperties.AutomationId="StartWorkspaceSearchButton"/>
                                    <TextBox x:Name="WorkspaceQuery" MaxLength="256" VerticalContentAlignment="Center"
                                             Padding="6,4" KeyDown="WorkspaceQuery_KeyDown"
                                             AutomationProperties.Name="Aranacak not adı veya metin"
                                             AutomationProperties.AutomationId="WorkspaceSearchQuery"/>
                                </DockPanel>
                                <TextBlock x:Name="WorkspaceSearchStatus" Text="Arama yapmak için bir terim yazın."
                                           TextWrapping="Wrap" Foreground="{DynamicResource PrimaryInk}"
                                           AutomationProperties.AutomationId="WorkspaceSearchStatus"/>
                            </StackPanel>
                            <Button DockPanel.Dock="Bottom" HorizontalAlignment="Right" Content="Seçili Notu Aç"
                                    Margin="0,8,0,0" Padding="12,5" Click="OpenWorkspaceResult_Click"
                                    AutomationProperties.AutomationId="OpenWorkspaceSearchResult"/>
                            <ListBox x:Name="WorkspaceSearchResults" MouseDoubleClick="OpenWorkspaceResult_Click"
                                     KeyDown="WorkspaceResults_KeyDown"
                                     AutomationProperties.Name="Not arama sonuçları"
                                     AutomationProperties.AutomationId="WorkspaceSearchResults">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="AutomationProperties.Name" Value="{Binding RelativePath}"/>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="5,4">
                                            <TextBlock Text="{Binding RelativePath}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding MatchLabel}" FontSize="11"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>
        <Border Grid.Row="2" Background="#EEF2F7" BorderBrush="#E2E8F0"
                BorderThickness="0,1,0,0">
            <TextBlock Margin="16,5" FontSize="11" Foreground="#475569"
                       Text="{Binding StatusText}"/>
        </Border>
    </Grid>
</Window>
