<Window x:Class="Embasic.ENote.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Embasic E-Note — Geliştirme Önizlemesi"
        Width="1200" Height="780" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#F7F9FC" FontFamily="Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="58" />
            <RowDefinition Height="*" />
            <RowDefinition Height="29" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0"
                BorderThickness="0,0,0,1">
            <DockPanel Margin="20,0" LastChildFill="True" VerticalAlignment="Center">
                <TextBlock Text="EMBASIC" FontWeight="Bold" FontSize="17"
                           Foreground="#0E76B8" Margin="0,0,12,0"
                           ToolTip="Geçici marka metni; resmi Embasic logo dosyası henüz eklenmedi." />
                <TextBlock Text="E-Note" FontWeight="SemiBold" FontSize="17"
                           Foreground="#172033" />
                <TextBlock Text="  ·  TUR 01 / geliştirme iskeleti"
                           FontSize="12" Foreground="#64748B"
                           VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="220" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" MinWidth="400" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Background="White">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Margin="18,20,18,12">
                    <TextBlock Text="ÇALIŞMA ALANI" FontSize="12" FontWeight="Bold"
                               Foreground="#475569" />
                    <TextBlock Text="Henüz bağlanmadı" Margin="0,12,0,0"
                               Foreground="#64748B" />
                </StackPanel>
                <TextBlock Grid.Row="1" Margin="18,8" TextWrapping="Wrap"
                           Foreground="#64748B"
                           Text="Klasör ağacı, simgeler ve yerel çalışma alanı sonraki geliştirme turlarında etkinleşecek." />
                <Border Grid.Row="2" Margin="14" Padding="10"
                        BorderBrush="#E2E8F0" BorderThickness="1"
                        CornerRadius="5" MinHeight="76"
                        AutomationProperties.Name="Etkin olmayan reklam alanı">
                    <StackPanel>
                        <TextBlock Text="REKLAM" FontSize="10"
                                   Foreground="#64748B" FontWeight="Bold" />
                        <TextBlock Text="Sağlayıcı yok · çevrimdışı / pasif"
                                   TextWrapping="Wrap" Margin="0,6,0,0"
                                   Foreground="#64748B" />
                    </StackPanel>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="1" ResizeDirection="Columns"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Background="#E2E8F0" ShowsPreview="True" />

            <Grid Grid.Column="2" Margin="18">
                <TabControl>
                    <TabItem Header="Başlangıç">
                        <StackPanel Margin="26">
                            <TextBlock Text="Embasic E-Note" FontSize="27"
                                       FontWeight="SemiBold" Foreground="#172033" />
                            <TextBlock Margin="0,18,0,0" TextWrapping="Wrap"
                                       Foreground="#334155"
                                       Text="Bu pencere, Windows WPF uygulama iskeletidir. Henüz not düzenleme veya kaydetme özelliği içermez." />
                            <TextBlock Margin="0,16,0,0" TextWrapping="Wrap"
                                       Foreground="#9A3412"
                                       Text="Güvenlik: .emd şifreleme ve anahtar yönetimi tamamlanmadığı için güvenli not oluşturma/açma devre dışıdır." />
                            <TextBlock Margin="0,16,0,0" TextWrapping="Wrap"
                                       Foreground="#475569"
                                       Text="Sonraki aşama: .emd v1 kapsayıcı, güvenlik testleri ve gerçek çalışma alanı." />
                        </StackPanel>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="#EEF2F7" BorderBrush="#E2E8F0"
                BorderThickness="0,1,0,0">
            <TextBlock Margin="16,5" FontSize="11" Foreground="#475569"
                       Text="{Binding StatusText}" />
        </Border>
    </Grid>
</Window>
